{
  "name": "bga/goa",
  "type": "project",
  "require": {
    "php": ">=8.4"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5",
    "phpunit/php-code-coverage": "^10.1"
  },
  "autoload": {
    "psr-4": {
      "Bga\\Games\\Goa\\": "modules/php/"
    }
  }

  ,"scripts": {
    "test": "@php vendor/bin/phpunit --colors --display-errors --bootstrap tests/bootstrap.php tests --testdox-html testsresults/results.html",
    "test:coverage": "@php -dxdebug.mode=coverage vendor/bin/phpunit --colors --display-errors --bootstrap tests/bootstrap.php tests --testdox-html testsresults/results.html --coverage-html testsresults\\coverage/ > testsresults/coverage.log",
    "test:deprecation": "@php vendor/bin/phpunit --colors --display-errors --display-deprecation --bootstrap tests/bootstrap.php tests > testsresults/check_deprecation.log"
  }
}