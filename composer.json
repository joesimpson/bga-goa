{
  "name": "bga/goa",
  "type": "project",
  "require": {
    "php": ">=8.4"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5",
    "phpunit/php-code-coverage": "^10.1"
  },
  "autoload": {
    "psr-4": {
      "Bga\\Games\\Goa\\": "modules/php/"
    }
  }

  ,"scripts": {
    "test": "@php vendor/bin/phpunit --colors --display-errors --bootstrap tests/bootstrap.php tests",
    "test:coverage": "@php -dxdebug.mode=coverage vendor/bin/phpunit --colors --display-errors --bootstrap tests/bootstrap.php tests --coverage-html testsresults\\coverage/"
  }
}